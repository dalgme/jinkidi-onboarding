# ─────────────────────────────────────────────────────────────
# Supabase — 리전은 반드시 ap-northeast-2 (Seoul)
# ─────────────────────────────────────────────────────────────
# 프로젝트 URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# anon public key — 클라이언트 노출 허용
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — 서버 전용. NEXT_PUBLIC_ 접두사 절대 금지
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# 메일 (Resend) — 발신 도메인에 SPF·DKIM·DMARC 설정 필수
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="온보딩 허브 <noreply@example.com>"
# 개발 환경에서 실제 발송 대신 콘솔 출력 (true|false)
MAIL_DRY_RUN=true

# ─────────────────────────────────────────────────────────────
# 검증 API (개발사 자격증명) — 모두 서버 전용
# ─────────────────────────────────────────────────────────────
# GitHub fine-grained PAT, read:org 권한
GITHUB_TOKEN=
# 개발사 GitHub username — 멤버십 검증 대상
GITHUB_AGENCY_USERNAME=
# Vercel Access Token (팀 스코프)
VERCEL_TOKEN=
# 개발사 Vercel user id — 팀 멤버 목록에서 대조
VERCEL_AGENCY_USER_ID=
# Supabase Management API PAT
SUPABASE_MGMT_TOKEN=
# 개발사 Supabase 계정 이메일 — 조직 멤버 목록에서 대조
SUPABASE_AGENCY_EMAIL=
# DNS 검증에서 "Vercel을 가리킨다"고 판정할 타깃 (쉼표 구분)
VERCEL_DNS_TARGETS=cname.vercel-dns.com,76.76.21.21

# ─────────────────────────────────────────────────────────────
# 앱
# ─────────────────────────────────────────────────────────────
# 배포 URL. 매직링크 redirectTo·메일 CTA에 사용
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 의뢰인이 초대할 개발사 담당자 이메일 (딥링크 화면의 "이메일 복사")
NEXT_PUBLIC_AGENCY_INVITE_EMAIL=
# Vercel Cron 인증 시크릿
CRON_SECRET=
# 고정비 계산기 환율 (USD→KRW). 자동 조회하지 않는다
COST_USD_KRW_RATE=1380
